{
  "name": "ledgerline",
  "version": "0.0.0",
  "description": "Payment orchestration API with an immutable double-entry ledger and settlement reconciliation.",
  "private": true,
  "license": "MIT",
  "author": "Lucas Ribeiro",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src *.mjs",
    "lint:fix": "eslint src *.mjs --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
